# Base URL of the PingAM server, including the deployment path (no trailing slash).
# HTTPS recommended (see README Phần 1.7, e.g. via a Caddy reverse proxy in
# front of Tomcat); serverConfig.baseUrl in useJourneyLogin.ts also works fine
# over plain HTTP if you haven't set that up yet - this app has no HTTPS
# requirement of its own. Must be on the SAME top-level domain as this app in
# production for the AM session cookie to be usable (see README Phần 1.6
# "Domain & cookie").
VITE_AM_BASE_URL=https://idp.xbank.test:8446/openam

# Fallback realm path used only when AM does not pass a `realm` query param
# (AM always passes one when it builds the Custom Login URL Template with
# `<#if realm??>&realm=${realm}</#if>`, so this is just a local-dev default).
# Empty string = top-level/root realm. Replace with your own realm.
VITE_DEFAULT_REALM=test-lab

# Fallback authentication tree (journey) name used only when AM does not pass
# a `service` query param. Replace with the actual tree name configured on
# your PingAM instance.
VITE_DEFAULT_TREE=xbank-login
