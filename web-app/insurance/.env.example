# OIDC discovery URL for the realm this client is registered in. Requires the
# OAuth2 Provider service AND Base URL Source (X-Forwarded-* headers) to be
# configured on that realm first (see README Phần 1.1 / 1.7), otherwise AM
# returns {"error":"not_found","error_description":"No OAuth2 provider for realm ..."}.
# This lab's client is registered in the "test-lab" realm (matches the login
# UI's tree); replace with your own realm's wellknown URL.
VITE_OIDC_WELLKNOWN=https://idp.xbank.test:8446/openam/oauth2/realms/root/realms/test-lab/.well-known/openid-configuration

# OAuth2/OIDC client registered on PingAM for THIS app. Must be a Public
# client (PKCE, no secret) since this is a browser SPA. Must be a DIFFERENT
# client_id than oidc-test-app's, but both clients should point their
# "Custom Login URL Template" at the same shared login UI to prove sharing.
VITE_OIDC_CLIENT_ID=insurance-web

# Must be one of the client's registered Redirection URIs on AM, and match
# this app's own origin (see vite.config.ts ALLOWED_HOSTS/port). https:// is
# required here (not http://) so `crypto.subtle` is available for PKCE - see
# ../README.md Phần 3.2 "Bắt buộc: HTTPS local cho web-app (mkcert)".
VITE_OIDC_REDIRECT_URI=https://insurance.xbank.test:5175/callback

VITE_OIDC_SCOPE=openid profile email
